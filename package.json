{
  "name": "virtubox-sales-copilot",
  "version": "2.0.0",
  "description": "ChatGPT-style assistant for the VirtuBox sales team. Answers from docs.virtubox.io, virtubox.io, the sales Google Drive folder and local knowledge files. Runs 24/7 under PM2.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "ingest": "node scripts/ingest.js",
    "ingest:sites": "node scripts/ingest.js --only=sites",
    "ingest:drive": "node scripts/ingest.js --only=drive",
    "ingest:local": "node scripts/ingest.js --only=local"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "unpdf": "^0.12.2"
  },
  "engines": {
    "node": ">=18"
  }
}
