# ───────────── LLM (Groq) ─────────────
# Comma-separated Groq keys. The server rotates to the next key on a rate limit.
GROQ_API_KEYS=gsk_xxxxxxxxxxxxxxxx,gsk_yyyyyyyyyyyyyyyy
GROQ_MODEL=openai/gpt-oss-120b
# Vision model used ONLY during ingest to read PNG/JPG one-pagers from Drive / knowledge/
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional fallback if every Groq key is rate-limited
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ───────────── Knowledge sources ─────────────
CRAWL_SEED_URLS=https://docs.virtubox.io/,https://www.virtubox.io/,https://www.virtubox.io/resources/
CRAWL_MAX_PAGES=400

# Google Drive "One Pagers" folder (must be shared as "Anyone with the link can view")
DRIVE_FOLDER_ID=1rJJ2WvUF5s-jyTFVohLXMwd5Vr_uoNRR
# Optional. Without it the public folder page is read directly, which is enough for a link-shared folder.
GOOGLE_API_KEY=
# Optional. Sub-folders to leave out of the copilot, comma-separated, e.g. Solutions (Pricing)
DRIVE_EXCLUDE_FOLDERS=

# Re-build the knowledge index automatically every N hours (0 = never; run `npm run ingest` manually)
AUTO_REFRESH_HOURS=24

# ───────────── Server ─────────────
PORT=3000
MAX_REQUESTS_PER_MIN=30
MAX_CONCURRENT_REQUESTS=2

# ───────────── Vercel only ─────────────
# Chat history needs a database on Vercel (its disk is read-only). Add the free "Upstash for Redis"
# integration from the Vercel Storage tab — it sets these automatically. Not needed on a normal server.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
