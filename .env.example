# Comma-separated list of Groq API keys - add as many as you have; the server
# rotates to the next one automatically whenever it hits a rate limit.
GROQ_API_KEYS=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,gsk_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: only used if every Groq key above is rate-limited. Get a free key
# at https://openrouter.ai/keys (many models there have a free tier).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Sites the ingestion script will crawl to build the knowledge index
CRAWL_SEED_URLS=https://docs.virtubox.io/,https://www.virtubox.io/
CRAWL_MAX_PAGES=200

# How many requests/minute your OWN backend accepts, per visitor IP
MAX_REQUESTS_PER_MIN=20
# How many requests your backend sends to Groq at once. 1 = fully serialized
# (safest against rate limits). Raise only if you have multiple keys.
MAX_CONCURRENT_REQUESTS=1

PORT=3000
